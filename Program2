#include <iostream>
#include <fstream>
#include <sstream>
#include <string>

using namespace std;

int main() {
  // Declare the needed file items needed for this program.
    string fileName;
    ifstream infile;
// Prompt the user for the name of the file to be read.
    cout << "Please enter the name of the data file: ";
    cin >> fileName;
// Check if the file opens, provide a fail-safe message if it does not.
    infile.open(fileName);
    if (infile.fail()) {
        cout << "Could not open file " << fileName << endl;
        return 1;
    }

    string firstName = "";
    string lastName = "";
    string line;
// Read the file line by line and check each name to see if it is the first or last alphabetically.
    while (getline(infile, line)) {
        stringstream ss(line);
        string name;

        while (ss >> name) {
            if (firstName.empty() || name < firstName) {
                firstName = name;
            }
            if (lastName.empty() || name > lastName) {
                lastName = name;
            }
        }
    }

    infile.close();
// Print out the first and last names.
    cout << "First name alphabetically: " << firstName << endl;
    cout << "Last name alphabetically: " << lastName << endl;

    return 0;
}
